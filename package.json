{
  "name": "nutriguard-egypt",
  "version": "0.1.0",
  "description": "NutriGuard - a nutrition assistant restricted to verified Egyptian food. Step 0: project foundation.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.6.0"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:smoke": "node --import tsx src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "docs:check": "node scripts/docs-link-check.mjs",
    "audit": "node --import tsx src/scripts/run-audit.ts",
    "stage": "node --import tsx src/scripts/stage-recipes.ts",
    "test": "node --import tsx --test \"tests/**/*.test.ts\""
  },
  "dependencies": {},
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^24.0.0",
    "eslint": "^9.17.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0"
  }
}