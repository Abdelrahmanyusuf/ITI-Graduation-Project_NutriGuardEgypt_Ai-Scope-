# NutriGuard local configuration template
# Copy this file to .env and add real values there. Never commit .env or secrets.

NODE_ENV=development
PORT=3000

# Optional graduation-demo hybrid retrieval.
# When every required value is present, NutriGuard tries Gemini embeddings and
# Qdrant first. A timeout, rejected key, unavailable service, or empty result
# automatically falls back to the deterministic local retriever.
HYBRID_RETRIEVAL_ENABLED=true
GEMINI_API_KEY=
EMBEDDING_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSIONS=3072
QDRANT_URL=
QDRANT_API_KEY=
# Keep graduation vectors isolated from any future production corpus.
QDRANT_COLLECTION=nutriguard_graduation_demo
RETRIEVAL_CORPUS_ID=NUTRIGUARD-EGYPT-GRADUATION-DEMO-V2
# Used only when you explicitly run `npm run ingest:retrieval`.
RETRIEVAL_CORPUS_PATH=data/demo/retrieval-corpus.demo.json

# Per remote operation. The graduation demo clamps this to 0.25–10 seconds.
TIMEOUT_SECONDS=2
# After a remote failure, use local retrieval immediately for this many seconds.
RETRIEVAL_CIRCUIT_BREAKER_SECONDS=30

# Offline ingestion pacing; these do not affect ordinary chat requests.
EMBEDDING_BATCH_SIZE=32
EMBEDDING_BATCH_DELAY_MS=10000
EMBEDDING_MAX_RETRIES=4
EMBEDDING_RETRY_BASE_DELAY_MS=5000

# Optional public backend-team catalog. Failures already fall back to local data.
NUTRIGUARD_BACKEND_BASE_URL=http://nutriguard.runasp.net
# Optional real meal-log integration. When set, confirmation calls
# POST /api/Tracking/custom-meals instead of the local mock. The token must be the
# service/user bearer token accepted by the dashboard backend.
# NUTRIGUARD_DASHBOARD_BASE_URL=http://localhost:5000
# NUTRIGUARD_DASHBOARD_TOKEN=
# NUTRIGUARD_DASHBOARD_TIMEOUT_MS=10000

# --- Step 17b: narrowly-scoped Claude classifier/formatter layer ---
# Entirely optional. With none of these set, the Claude layer is inert and the
# agent behaves exactly as it did before Step 17b.
#
# Claude is allowed exactly two jobs: advisory intent classification that never
# decides routing, and rephrasing facts the deterministic pipeline already
# computed. It never performs arithmetic, never supplies a fact, and never holds
# authority over a write action. See docs/STEP_17B_CLAUDE_LAYER.md.
# The Claude model is reached through OpenRouter's OpenAI-compatible API.
OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Optional OpenRouter attribution headers:
# OPENROUTER_SITE_URL=https://your-app.example
# OPENROUTER_APP_NAME=NutriGuard

# Model identifiers are intentionally NOT defaulted: a stage stays disabled until
# you name its model explicitly, so this repository never implies that a
# particular model version was verified.
#
# REQUIREMENT: the classifier uses forced tool-calling for structured output, so
# its model MUST support tool use. A model without it fails instantly with
# HTTP 404 "No endpoints found that support tool use".
#
# Probed against one real OpenRouter key on 2026-08-19 (availability is per
# account, so re-check for yours):
#   openai/gpt-4o-mini                      tool use OK, ~1.4 s  <- recommended
#   deepseek/deepseek-chat                  tool use OK, ~2.0 s
#   deepseek/deepseek-r1-distill-llama-70b  NO tool use (404); ~30 s for text
#   anthropic/claude-3.5-haiku              not available on that key (404)
#   google/gemini-2.0-flash-001             not available on that key (404)
#
# Avoid reasoning models here. They spend tens of seconds emitting chain-of-
# thought, which is wasted effort for rephrasing text that is already final.
CLAUDE_CLASSIFIER_MODEL=
CLAUDE_FORMATTER_MODEL=

# Master switches. Each defaults to on only when its model above is set.
# CLAUDE_CLASSIFIER_ENABLED=1
# CLAUDE_FORMATTER_ENABLED=1

# Per-stage timeouts in seconds, clamped to 0.25-30. On timeout the deterministic
# result is used with no user-visible degradation.
#
# IMPORTANT: both stage timeouts plus a 5 s deterministic reserve are clamped to
# fit inside REQUEST_TIMEOUT_SECONDS. Setting 30 s here against a 15 s request
# budget previously made the whole HTTP request time out, surfacing a generic 500
# ("The service could not complete the request.") instead of the correct answer.
# Values are now reduced automatically and a warning is logged, but keep them
# small so the deterministic fallback always has room to reply.
CLAUDE_CLASSIFIER_TIMEOUT_SECONDS=3
CLAUDE_FORMATTER_TIMEOUT_SECONDS=6

# Total server-side budget for one request; mirrors the HTTP request timeout.
REQUEST_TIMEOUT_SECONDS=15

# Resolve a bare conversational reference ("اعرضلي مكونات الوصفه", "show me its
# ingredients") to one recipe id from a CLOSED candidate list that deterministic
# session memory already recorded. The deterministic cue is tried first; the model
# is consulted only when that finds nothing, and any id outside the candidate list
# is rejected. Defaults on when the classifier is enabled.
# CLAUDE_REFERENCE_RESOLUTION_ENABLED=1

# Per-intent formatter switches (all default on, each with a mandatory grounding
# fallback). There is deliberately NO variable for medical_safety: it is
# hard-disabled in code and cannot be enabled by configuration.
# CLAUDE_FORMATTER_RECIPE_NUTRITION=1
# CLAUDE_FORMATTER_INGREDIENT_NUTRITION=1
# CLAUDE_FORMATTER_COMPARE_RECIPES=1
# CLAUDE_FORMATTER_LIGHTER_MODIFICATION=1
# CLAUDE_FORMATTER_FIND_RECIPE=1
# CLAUDE_FORMATTER_GENERAL_GUIDELINE=1
# CLAUDE_FORMATTER_MEAL_PLAN=1

# Internal observability route GET /internal/v1/claude-trace. Requires BOTH the
# flag and a token; without them the route returns 404. Never enabled by default.
# Traces carry structural data only and never the raw user message.
# CLAUDE_DEBUG_PANEL_ENABLED=0
# CLAUDE_DEBUG_PANEL_TOKEN=
# CLAUDE_DEBUG_TRACE_BUFFER=50

# Separate, explicitly-scoped opt-in that allows raw message text into trace
# records for regression analysis. The debug panel strips it regardless.
# CLAUDE_DEBUG_RAW_MESSAGES=0

# PostgreSQL / production values are intentionally placeholders. Production
# starts only through its strict evidence and configuration gates.
# DATABASE_URL=postgresql://user:password@localhost:5432/nutriguard
# DEPLOYMENT_TARGET=staging
# HOST=0.0.0.0
# RELEASE_ID=reviewed-release-id
# ALLOWED_ORIGINS=https://nutri-guard-frontend.vercel.app,http://localhost:5173
# RETRIEVAL_CORPUS_ID=approved-corpus-id
# METRICS_TOKEN=replace-via-secret-manager-minimum-24-characters
# NUTRIGUARD_RELEASE_EVIDENCE=/run/secrets/nutriguard-release-evidence.json
# PILOT_CONSENT_REFERENCE=approved-consent-document-id
# PRIVACY_NOTICE_VERSION=approved-version

# Test-only database safety switches. Never enable against production.
# NUTRIGUARD_ALLOW_SYNTHETIC_SEED=0
# NUTRIGUARD_RUN_DB_INTEGRATION=0
