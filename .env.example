# NutriGuard runtime configuration
#
# The Step 0 foundation reads and validates only NODE_ENV and PORT (see
# src/config/env.ts). It does NOT read or require any API key, and it does not
# load this file automatically — run with your runtime of choice; NODE_ENV and
# PORT are picked up from the process environment.
#
# Providing a .env is entirely optional for the foundation (defaults apply).

# One of: development | test | production
NODE_ENV=development

# Whole decimal integer in the range 1..65535 (validated strictly).
PORT=3000

# --- Optional: PostgreSQL connection (Step 4) ---
# Used ONLY by the migration runner (npm run db:*) and the DB integration test.
# Not required for the foundation. Postgres's standard PG* variables are also
# honoured (PGHOST, PGPORT, PGUSER, PGPASSWORD, PGDATABASE). Keep secrets out
# of source control; never commit a real DATABASE_URL.
# DATABASE_URL=postgres://user:password@localhost:5432/nutriguard

# --- Test-only safety flags (Step 4) ---
# NUTRIGUARD_ALLOW_SYNTHETIC_SEED must be 1 to load the explicitly synthetic
# seed used only by the DB integration test (npm run db:seed:synthetic). Never
# set in production.
# NUTRIGUARD_ALLOW_SYNTHETIC_SEED=0

# NUTRIGUARD_RUN_DB_INTEGRATION must be 1 to run the destructive DB integration
# suite (it creates and drops its own disposable `ng_it_*` schema and refuses
# database names that do not include "test"). Never set in production.
# NUTRIGUARD_RUN_DB_INTEGRATION=0

# --- Legacy reference only (NOT read by the foundation) ---
# OPENROUTER_API_KEY was used by the archived, non-executable prototype in
# legacy/. It is not required by src/ and the legacy code is not runnable here.
# OPENROUTER_API_KEY=