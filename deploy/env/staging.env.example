NODE_ENV=production
DEPLOYMENT_TARGET=staging
HOST=0.0.0.0
PORT=3000
RELEASE_ID=replace-with-reviewed-release-id
ALLOWED_ORIGINS=https://nutri-guard-frontend.vercel.app,http://localhost:5173
DATABASE_URL=postgresql://replace-through-secret-store
QDRANT_URL=https://qdrant-staging.example.invalid
QDRANT_API_KEY=replace-through-secret-store
QDRANT_COLLECTION=nutriguard_staging_approved
EMBEDDING_BASE_URL=https://embedding-provider.example.invalid/v1
EMBEDDING_API_KEY=replace-through-secret-store
EMBEDDING_MODEL=replace-after-benchmark
RETRIEVAL_CORPUS_ID=replace-with-approved-corpus-id
NUTRIGUARD_RELEASE_EVIDENCE=/run/secrets/release-evidence.json
METRICS_TOKEN=replace-through-secret-store-minimum-24-chars
PILOT_CONSENT_REFERENCE=replace-with-approved-consent-reference
PRIVACY_NOTICE_VERSION=replace-with-approved-version
